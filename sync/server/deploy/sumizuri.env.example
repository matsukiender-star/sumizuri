# The settings of the Sumizuri sync server. Save a copy next to the compose file as the guide says, then change the parts in capitals.

# The address people type in the app, which is the address of your reverse proxy.
SUMIZURI_PUBLIC_URL=https://SYNC.YOUR-DOMAIN.COM

# Keep this on when a reverse proxy is in front of the server, so the address of each person is read from the headers the proxy adds. Turn it off if the server is reached directly.
SUMIZURI_TRUST_PROXY=on

# The biggest batch the server takes, in MB.
SUMIZURI_MAX_UPLOAD_MB=100

# Live settings. Each one set here is locked in the app. Leave them out to change them from the app instead.
SUMIZURI_NAME=Sumizuri sync
SUMIZURI_SIGNUP_MODE=invite
