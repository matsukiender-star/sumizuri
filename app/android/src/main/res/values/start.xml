<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The backgrounds of the default theme, shown while the app opens. -->
    <color name="start_light">#F5F4EF</color>
    <color name="start_dark">#0F1114</color>
    <color name="start_background">@color/start_light</color>
    <drawable name="start_mark">@drawable/splash_mark_light</drawable>

    <!-- The window of the app, in the background it opens with until the theme of the person is known. -->
    <style name="Theme.Sumizuri" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/start_background</item>
    </style>

    <!-- The splash screen, drawn by the app itself before Android 12, with the Sumizuri ink medallion. -->
    <style name="Theme.Sumizuri.Start" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/start_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/start_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Sumizuri</item>
    </style>
    <style name="Theme.Sumizuri.Start.Light">
        <item name="windowSplashScreenBackground">@color/start_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark_light</item>
    </style>
    <style name="Theme.Sumizuri.Start.Dark">
        <item name="windowSplashScreenBackground">@color/start_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark_dark</item>
    </style>

    <!-- The TV app opens on pure white or pure black, as the TV is set, with the medallion and the name beside it across the wide screen. Android 11 and older show it as the window; newer ones draw their own splash with the medallion. -->
    <color name="start_tv_light">#FFFFFF</color>
    <color name="start_tv_dark">#000000</color>
    <color name="start_tv_background">@color/start_tv_light</color>
    <drawable name="start_tv_mark">@drawable/splash_mark_light</drawable>
    <drawable name="start_tv_splash">@drawable/tv_splash_light</drawable>
    <style name="Theme.Sumizuri.Tv" parent="Theme.Sumizuri">
        <item name="android:windowBackground">@color/start_tv_background</item>
    </style>
    <style name="Theme.Sumizuri.Start.Tv" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/start_tv_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/start_tv_mark</item>
        <item name="android:windowBackground">@drawable/start_tv_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Sumizuri.Tv</item>
    </style>
    <style name="Theme.Sumizuri.Start.Tv.Light">
        <item name="windowSplashScreenBackground">@color/start_tv_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark_light</item>
        <item name="android:windowBackground">@drawable/tv_splash_light</item>
    </style>
    <style name="Theme.Sumizuri.Start.Tv.Dark">
        <item name="windowSplashScreenBackground">@color/start_tv_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark_dark</item>
        <item name="android:windowBackground">@drawable/tv_splash_dark</item>
    </style>
</resources>
