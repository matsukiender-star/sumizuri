root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# The formatter takes its rules from the root build file. These lines tell the editor the same, so it formats a file the way the formatter does.
[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
